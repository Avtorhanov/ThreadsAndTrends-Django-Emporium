# Продакшен: скопируйте в .env (это делает ./deploy.sh при первом запуске) и заполните
# обязательные поля. Пустые SECRET_KEY и DB_PASSWORD deploy.sh сгенерирует сам.

# ===== Обязательно =====
# Домен сайта без https:// (A-запись домена должна указывать на IP сервера).
# Для пробного запуска на своём компьютере: DOMAIN=localhost
DOMAIN=
# Администратор магазина (вход в панель https://<домен>/panel/). Пароль — не короче 8 символов,
# не только цифры. Создаётся при первом запуске; потом пароль меняется в панели/админке, не здесь.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Генерируются автоматически (не меняйте после первого запуска) =====
SECRET_KEY=
DB_PASSWORD=

# ===== Магазин =====
# Демо-товары с фото для проверки (1 — загрузить). Перед реальным запуском удалите
# демо-товары в панели и поставьте 0.
SEED_DEMO=1
# Адрес пункта самовывоза (пусто — только курьер)
PICKUP_ADDRESS=
# Курьер 500 ₽, бесплатно от 10 000 ₽ (в копейках)
# DELIVERY_COURIER_KOPECKS=50000
# DELIVERY_FREE_FROM_KOPECKS=1000000
TIME_ZONE=Europe/Moscow

# ===== Почта (коды сброса пароля, уведомления о заказах) =====
# Например, Яндекс 360 / Mail.ru для бизнеса / Unisender Go. Без SMTP письма не уходят.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DiDi-shop <noreply@example.com>

# ===== Онлайн-оплата ЮKassa (см. docs/LAUNCH.md, шаг «ЮKassa») =====
# Включайте True только вместе с ключами, иначе приложение не запустится.
ORDERS_ONLINE_PAYMENT_ENABLED=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чеки 54-ФЗ: сверьте с бухгалтером. Система налогообложения: 1 ОСН, 2 УСН доходы,
# 3 УСН доходы минус расходы, 6 патент; НДС: 1 — без НДС. Самозанятым — PAYMENTS_RECEIPTS_ENABLED=False.
PAYMENTS_RECEIPTS_ENABLED=True
PAYMENTS_TAX_SYSTEM_CODE=2
PAYMENTS_VAT_CODE=1
PAYMENTS_RECEIPT_PAYMENT_MODE=full_payment

# ===== Мониторинг (необязательно) =====
# Sentry: создайте проект Django на sentry.io и вставьте DSN — ошибки будут приходить на почту.
SENTRY_DSN=

# ===== Тонкая настройка (обычно не нужна) =====
# Email для Let's Encrypt (по умолчанию ADMIN_EMAIL)
# ACME_EMAIL=
# Воркеры gunicorn (≈ 2 × ядер CPU + 1)
# GUNICORN_WORKERS=3
# Бэкапы: расписание (cron, UTC) и сколько дней хранить
# BACKUP_CRON=30 0 * * *
# BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO
