# Продакшен: ./deploy.sh сам создаст .env из этого файла. Обязательно только ADMIN_EMAIL
# (если не заполнить, deploy.sh спросит). Пустые DOMAIN, ADMIN_PASSWORD, SECRET_KEY и
# DB_PASSWORD deploy.sh заполнит сам.

# ===== Адрес сайта =====
# Свой домен без https:// (A-запись домена → IP сервера), например shop.example.ru.
# Пусто — бесплатный адрес <IP-сервера>.sslip.io с HTTPS (подходит для старта и тестов).
# Для пробного запуска на своём компьютере: DOMAIN=localhost
DOMAIN=

# ===== Администратор =====
# Вход в панель https://<адрес>/panel/. Пустой пароль deploy.sh сгенерирует и покажет в конце.
# Создаётся при первом запуске; потом пароль меняется в панели/админке, не здесь.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Генерируются автоматически (не меняйте после первого запуска) =====
SECRET_KEY=
DB_PASSWORD=

# ===== Приложение для Android =====
# Ссылка «Скачать приложение для Android» в баннере и подвале сайта на Android-телефонах
# (пусто — не показывать). APK собирает
# GitHub Actions (docs/LAUNCH.md, шаг «Android») и кладёт в Releases под этим именем.
ANDROID_APK_URL=https://github.com/Avtorhanov/ThreadsAndTrends-Django-Emporium/releases/latest/download/didi-shop.apk

# ===== Магазин =====
# Демо-товары с фото для проверки (1 — загрузить). Перед реальным запуском удалите
# демо-товары в панели и поставьте 0.
SEED_DEMO=1
# Адрес пункта самовывоза (пусто — только курьер)
PICKUP_ADDRESS=
# Курьер 500 ₽, бесплатно от 10 000 ₽ (в копейках)
# DELIVERY_COURIER_KOPECKS=50000
# DELIVERY_FREE_FROM_KOPECKS=1000000
TIME_ZONE=Europe/Moscow

# ===== Продавец (подвал сайта, оферта, политика ПДн) =====
# Обязательны до подключения ЮKassa: она проверяет реквизиты и юридические страницы сайта.
# Тексты страниц — заготовки в web/templates/web/legal/, их проверяет юрист (docs/LAUNCH.md).
SELLER_NAME=
SELLER_INN=
SELLER_OGRN=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_PHONE=

# ===== Вкладка «Контакты» (сайт и приложение) =====
# Пусто — кнопка не показывается. Телефон и почта — SELLER_PHONE и SELLER_EMAIL выше.
# WhatsApp — номер телефона, Telegram — @имя или ссылка t.me/имя, ВКонтакте — имя или vk.com/имя.
CONTACT_WHATSAPP=
CONTACT_TELEGRAM=
CONTACT_VK=
# Подписи под кнопками (пусто — подпись по умолчанию).
CONTACT_WHATSAPP_NOTE=
CONTACT_TELEGRAM_NOTE=
CONTACT_VK_NOTE=

# ===== Почта (коды сброса пароля, уведомления о заказах) =====
# Например, Яндекс 360 / Mail.ru для бизнеса / Unisender Go. Без SMTP письма не уходят.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DiDi-shop <noreply@example.com>

# ===== Онлайн-оплата ЮKassa (docs/LAUNCH.md, шаг «ЮKassa») =====
# Включайте True только вместе с ключами, иначе приложение не запустится.
ORDERS_ONLINE_PAYMENT_ENABLED=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чеки 54-ФЗ: сверьте с бухгалтером. Система налогообложения: 1 ОСН, 2 УСН доходы,
# 3 УСН доходы минус расходы, 6 патент; НДС: 1 — без НДС. Самозанятым — PAYMENTS_RECEIPTS_ENABLED=False.
PAYMENTS_RECEIPTS_ENABLED=True
PAYMENTS_TAX_SYSTEM_CODE=2
PAYMENTS_VAT_CODE=1
PAYMENTS_RECEIPT_PAYMENT_MODE=full_payment

# ===== Мониторинг (необязательно) =====
# Sentry: создайте проект Django на sentry.io и вставьте DSN — ошибки будут приходить на почту.
SENTRY_DSN=

# ===== Тонкая настройка (обычно не нужна) =====
# Email для Let's Encrypt (по умолчанию ADMIN_EMAIL)
# ACME_EMAIL=
# Воркеры gunicorn (≈ 2 × ядер CPU + 1)
# GUNICORN_WORKERS=3
# Бэкапы: расписание (cron, UTC) и сколько дней хранить
# BACKUP_CRON=30 0 * * *
# BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO

# ===== Служебное: пишет deploy.sh =====
# Прежние адреса, которые продолжают работать после смены DOMAIN (через запятую).
EXTRA_DOMAINS=
# Все адреса сайта и разрешённые адреса возврата после оплаты — пересчитываются при деплое.
SITE_HOSTS=
RETURN_URL_PREFIXES=
