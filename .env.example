# Скопируйте в .env. Для docker compose всё ниже необязательно — есть значения по умолчанию.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# PostgreSQL (при запуске без Docker укажите DB_HOST=localhost)
DB_NAME=didi
DB_USER=didi
DB_PASSWORD=didi
DB_HOST=localhost
DB_PORT=5432

# Кэш: db://django_cache | redis://redis:6379/1 | locmem:// | dummy://
CACHE_URL=db://django_cache

# Фоновые задачи: database | immediate | dummy | <полный путь к классу бэкенда>
TASKS_BACKEND=database

# Почта (сброс пароля и уведомления). В dev по умолчанию письма печатаются в консоль.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=DiDi-shop <noreply@example.com>

# JWT мобильного клиента
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# JWT_SIGNING_KEY=           # по умолчанию SECRET_KEY

# Число доверенных прокси перед приложением (за nginx — 1). Влияет на определение IP для rate limit.
NUM_PROXIES=0
# Лимиты (формат N/second|min|hour|day): THROTTLE_AUTH_LOGIN, THROTTLE_AUTH_LOGIN_EMAIL,
# THROTTLE_AUTH_REGISTER, THROTTLE_AUTH_SENSITIVE, THROTTLE_PASSWORD_RESET,
# THROTTLE_PASSWORD_RESET_CONFIRM, THROTTLE_PASSWORD_RESET_CONFIRM_EMAIL, THROTTLE_CART_QUOTE, THROTTLE_ORDER_CREATE

# Корзина: максимум единиц одного товара (и не больше остатка) и позиций в корзине
# CART_MAX_QUANTITY=10
# CART_MAX_ITEMS=50

# Заказы: курьер 500 ₽, бесплатно от 10 000 ₽ (в копейках); адрес самовывоза (пусто — без самовывоза)
# DELIVERY_COURIER_KOPECKS=50000
# DELIVERY_FREE_FROM_KOPECKS=1000000
PICKUP_ADDRESS=
# Онлайн-оплата (ЮKassa): включайте вместе с ключами магазина, иначе Django не запустится
ORDERS_ONLINE_PAYMENT_ENABLED=False
# Неоплаченный онлайн-заказ отменяется через N минут
# ORDERS_UNPAID_TIMEOUT_MINUTES=30
# Лимит оформлений заказа на пользователя
# THROTTLE_ORDER_CREATE=30/hour

# ЮKassa: ключи тестового магазина для разработки (боевые — только на сервере)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адреса возврата в приложение после оплаты; для Expo Go добавьте exp://
PAYMENTS_RETURN_URL_PREFIXES=didishop://,exp://
# Адреса уведомлений ЮKassa (по умолчанию — официальный список); за nginx задайте NUM_PROXIES=1
# YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
# Чеки 54-ФЗ: система налогообложения (1 ОСН, 2 УСН доходы, 3 УСН доходы-расходы, 6 патент),
# НДС (1 — без НДС), признак расчёта. Согласуйте с бухгалтером. Самозанятым — PAYMENTS_RECEIPTS_ENABLED=False.
PAYMENTS_RECEIPTS_ENABLED=True
PAYMENTS_TAX_SYSTEM_CODE=2
PAYMENTS_VAT_CODE=1
PAYMENTS_RECEIPT_PAYMENT_MODE=full_payment
# Лимиты: THROTTLE_PAYMENT_START (30/hour), THROTTLE_PAYMENT_REFRESH (120/hour)

# Только для prod (myshop.settings.prod); финальная настройка — сессия 7
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=0
