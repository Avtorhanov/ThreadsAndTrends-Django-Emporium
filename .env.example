# Скопируйте в .env. Для docker compose всё ниже необязательно — есть значения по умолчанию.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# PostgreSQL (при запуске без Docker укажите DB_HOST=localhost)
DB_NAME=didi
DB_USER=didi
DB_PASSWORD=didi
DB_HOST=localhost
DB_PORT=5432

# Кэш: db://django_cache | redis://redis:6379/1 | locmem:// | dummy://
CACHE_URL=db://django_cache

# Фоновые задачи: database | immediate | dummy | <полный путь к классу бэкенда>
TASKS_BACKEND=database

# Почта (сброс пароля и уведомления). В dev по умолчанию письма печатаются в консоль.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=DiDi-shop <noreply@example.com>

# JWT мобильного клиента
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# JWT_SIGNING_KEY=           # по умолчанию SECRET_KEY

# Число доверенных прокси перед приложением (за nginx — 1). Влияет на определение IP для rate limit.
NUM_PROXIES=0
# Лимиты (формат N/second|min|hour|day): THROTTLE_AUTH_LOGIN, THROTTLE_AUTH_LOGIN_EMAIL,
# THROTTLE_AUTH_REGISTER, THROTTLE_AUTH_SENSITIVE, THROTTLE_PASSWORD_RESET,
# THROTTLE_PASSWORD_RESET_CONFIRM, THROTTLE_PASSWORD_RESET_CONFIRM_EMAIL

# Только для prod (myshop.settings.prod); финальная настройка — сессия 7
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=0
