{
  "expo": {
    "name": "DiDi-shop",
    "slug": "didi-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.didishop.app"
    },
    "android": {
      "package": "ru.didishop.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#13261C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "DiDi-shop",
      "shortName": "DiDi-shop",
      "lang": "ru",
      "themeColor": "#13261C",
      "backgroundColor": "#EBF1E2",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EBF1E2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#070E0A"
          }
        }
      ]
    ],
    "scheme": "didishop",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
