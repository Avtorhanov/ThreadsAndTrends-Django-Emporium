# Caddy: автоматический HTTPS (Let's Encrypt; для DOMAIN=localhost — локальный сертификат),
# HTTP → HTTPS, HTTP/3. SITE_ADDRESSES («домен, прежний-адрес») и ACME_EMAIL приходят из
# compose.prod.yml; значения готовит deploy.sh.
{
	email {$ACME_EMAIL}
}

# Панель работает с сессией администратора: скрипты только с этого домена (защита от XSS).
(spa_headers) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	header X-Frame-Options "DENY"
}

{$SITE_ADDRESSES} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Фото товаров (до 5 МБ) с запасом на multipart.
	request_body {
		max_size 12MB
	}

	# Статика Django (витрина, админка): в имени файла хэш содержимого (ManifestStaticFilesStorage),
	# после обновления меняется адрес — кэш на год безопасен.
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Имена фото — UUID, файл по адресу не меняется.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	# Панель администратора (SPA, base /panel/).
	redir /panel /panel/ 308
	handle /panel/* {
		import spa_headers
		root * /srv
		@assets path /panel/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /panel/index.html
		file_server
	}

	# Остальное — Django (gunicorn): веб-витрина (корень сайта, каталог, корзина, кабинет,
	# sitemap.xml, robots.txt, manifest.webmanifest; CSP — web.middleware), API и резервная админка. Caddy сам
	# выставляет X-Forwarded-For (реальный IP клиента; заголовок от клиента не доверяется)
	# и X-Forwarded-Proto.
	handle {
		reverse_proxy app:8000
	}

	log {
		output stdout
		format console
	}
}
